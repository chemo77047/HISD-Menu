{
  "manifest_version": 3,
  "name": "SNAP Agent - School Nutrition AI Purchasing Agent",
  "version": "2.3",
  "description": "SNAP Agent - School Nutrition AI Purchasing Agent. This is an internal pilot tool for Houston ISD Nutrition Services that is currently being tested for training purposes.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SNAP Agent",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "scan-order": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "Open SNAP Agent"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
